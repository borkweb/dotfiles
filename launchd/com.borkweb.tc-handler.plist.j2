<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.borkweb.tc-handler</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-l</string>
		<string>{{ ansible_env.HOME }}/bin/tc-handler</string>
